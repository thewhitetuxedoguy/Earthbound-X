# nxdk build for the Phase Distorter Xbox port. See README.md.
#
#   eval "$(/path/to/nxdk/bin/activate -s)"      # puts nxdk-cc/nxdk-cxx on PATH
#   make -C xbox NXDK_DIR=/path/to/nxdk          # -> EarthBound.iso / bin/default.xbe
#
# The first run executes tools/prepare_sources.py, which copies cpp/src + cpp/include
# into build/port with the exception/filesystem/SDL rewrites applied and mirrors the
# generated program into build/generated. Upstream files are never modified.

XBE_TITLE = EarthBound
GEN_XISO = $(XBE_TITLE).iso
NXDK_DIR ?= $(HOME)/nxdk
NXDK_CXX = y
NXDK_SDL = y

EB_XBOX := $(abspath $(CURDIR))
EB_ROOT := $(abspath $(EB_XBOX)/..)
EB_PORT := $(EB_XBOX)/build/port
EB_GEN := $(EB_XBOX)/build/generated
EB_GAME ?= us

ifeq ($(wildcard $(EB_PORT)/src/main_cpu_65816.cpp)$(wildcard $(EB_XBOX)/build/native_engine_sources.mk),)
$(info [ PREPARE ] copying and rewriting sources into build/port)
$(shell python3 $(EB_XBOX)/tools/prepare_sources.py --upstream $(EB_ROOT) --out $(EB_PORT) >&2)
endif
# Sources of the upstream eb_native_engine + eb_scene libraries (generated by prepare_sources.py).
include $(EB_XBOX)/build/native_engine_sources.mk

# Desktop-only frontend files (OpenGL window, CRT shader, ImGui panel, Win32 entry
# point, desktop main loop). They are replaced by the Xbox platform layer in src/.
EB_DESKTOP_ONLY := debug_panel crt_filter windows_entry desktop_application desktop_display \
                   frame_presenter scene_effects_renderer

EB_CORE_SRCS := $(filter-out $(addprefix $(EB_PORT)/src/,$(addsuffix .cpp,$(EB_DESKTOP_ONLY))), \
                $(wildcard $(EB_PORT)/src/*.cpp))
EB_DSP_SRCS := $(EB_PORT)/external/spc_dsp/SPC_DSP.cpp
EB_XBOX_SRCS := $(wildcard $(EB_XBOX)/src/*.cpp)
EB_GAMES ?= us jp
EB_GEN_SRCS := $(foreach game,$(EB_GAMES),$(shell find $(EB_GEN)/$(game) -name '*.cpp' 2>/dev/null))
# asset_profiles() (generated/generated_assets.cpp) identifies packs for BOTH regions, so
# it references the JP code template too. Only the data template is linked for JP; the JP
# translated program is not built, so the game refuses a JP pack with a clear message.
EB_GEN_SRCS += $(wildcard $(EB_GEN)/*.cpp) $(EB_GEN)/jp/generated_assets.cpp

SRCS = $(sort $(EB_XBOX_SRCS) $(EB_CORE_SRCS) $(EB_NATIVE_SRCS) $(EB_DSP_SRCS) $(EB_GEN_SRCS))

# These flags must apply ONLY to the port's own objects: nxdk compiles its libraries
# (libc++, pdclib, ...) through the same rule, and the force-included compat header
# would collide with libc++'s own sources.
EB_OBJS := $(SRCS:.cpp=.obj)
$(EB_OBJS): CXXFLAGS += -std=c++20 -Os -DXBOX \
            -include $(EB_XBOX)/compat/eb_xbox_compat.hpp \
            -I$(EB_XBOX)/compat -I$(EB_XBOX)/src \
            -I$(EB_PORT)/include -I$(EB_GEN) -I$(EB_PORT)/external/spc_dsp

include $(NXDK_DIR)/Makefile
